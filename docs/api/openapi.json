          "name",
          "country",
          "locale",
          "timezone",
          "currency"
        ],
        "title": "TenantPublicInfo",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "must_change_password": {
            "description": "Se `true`, a pessoa só pode usar `/me`, `/change-password` e `/logout` até trocar a senha provisória. As demais rotas respondem 403 `password_change_required`.",
            "title": "Must Change Password",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "reception",
              "professional"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "must_change_password"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token recebido no login ou no refresh (`access_token`).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API do **SPBella** (Agenda Salão), sistema de agendamento para salões e barbearias.\n\nGuia de uso, convenções (erros, datas, valores, autenticação) e exemplos: `docs/api/README.md` no repositório.",
    "title": "SPBella API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Verificação de vida (liveness). Não acessa o banco; responde 200 enquanto o processo estiver de pé. Usada pelo Docker e pelo monitor de disponibilidade. Não exige login.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "A API está no ar?",
        "tags": [
          "Saúde do sistema"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Verificação de prontidão (readiness). Executa `SELECT 1` no Postgres. Responde 503 com o código `database_unavailable` se o banco não responder em 3 segundos. Não exige login.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "A API está pronta para atender?",
        "tags": [
          "Saúde do sistema"
        ]
      }
    },
    "/t/{slug}": {
      "get": {
        "description": "Nome, idioma, fuso e moeda do salão. Usado pelo app e pela página de agendamento para se apresentar e formatar datas e valores. Não exige login e não traz dados pessoais. Salão inexistente ou suspenso responde 404 `tenant_not_found`.",
        "operationId": "get_public_info_t__slug__get",
        "parameters": [
          {
            "description": "Identificador do salão na URL.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "Identificador do salão na URL.",
              "examples": [
                "studio-bella"
              ],
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantPublicInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dados públicos do salão",
        "tags": [
          "Estabelecimento"
        ]
      }
    },
    "/t/{slug}/auth/change-password": {
      "post": {
        "description": "Troca a senha de quem está logado (inclusive a provisória do primeiro acesso).\n\n- `400 wrong_current_password`: senha atual errada.\n- `422 weak_password`: senha nova fraca. `fields[0].code` diz o motivo: `too_short` (menos de 8), `too_long` (mais de 128), `too_simple` (menos de 4 caracteres diferentes), `contains_email` (contém o e-mail) ou `same_as_current`.\n- Encerra **todas** as outras sessões e devolve uma sessão nova (novo access token e novo cookie).\n- Limite: 10 tentativas a cada 15 min.",
        "operationId": "change_password_t__slug__auth_change_password_post",
        "parameters": [
          {
            "description": "Identificador do salão na URL.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "Identificador do salão na URL.",
              "examples": [
                "studio-bella"
              ],
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Trocar a senha",
        "tags": [
          "Login"
        ]
      }
    },
    "/t/{slug}/auth/forgot-password": {
      "post": {
        "description": "Se existir uma conta ativa com o e-mail, envia um link para criar uma senha nova, válido por 30 minutos e de uso único, no idioma do salão. **Sempre** responde 202, exista a conta ou não.\n\nO link tem o formato `<app>/{slug}/reset-password#token=<token>`. O token vai depois do `#` para não ir parar em logs de servidor nem no cabeçalho Referer.\n\nExige `turnstile_token`. Limites: 5 pedidos por IP e 3 por e-mail a cada 15 min.",
        "operationId": "forgot_password_t__slug__auth_forgot_password_post",
        "parameters": [
          {
            "description": "Identificador do salão na URL.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "Identificador do salão na URL.",
              "examples": [
                "studio-bella"
              ],
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Esqueci a senha",
        "tags": [
          "Login"
        ]
      }
    },
    "/t/{slug}/auth/login": {
      "post": {
        "description": "Confere e-mail e senha. Se estiverem certos, devolve o access token e grava o cookie httpOnly de refresh (restrito a `/t/{slug}/auth`).\n\n- E-mail não diferencia maiúsculas.\n- E-mail inexistente, senha errada e conta desativada recebem a **mesma** resposta (`401 invalid_credentials`), para não revelar quem tem conta.\n- Exige `turnstile_token` (`400 turnstile_failed`).\n- Limites: 10 tentativas por conta a cada 15 min e 20 por IP por minuto (`429`, com `Retry-After`).\n- Se `user.must_change_password` vier `true`, o app deve levar à troca de senha.",
        "operationId": "login_t__slug__auth_login_post",
        "parameters": [
          {
            "description": "Identificador do salão na URL.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "Identificador do salão na URL.",
              "examples": [
                "studio-bella"
              ],
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Entrar",
        "tags": [
          "Login"
        ]
      }
    },
    "/t/{slug}/auth/logout": {
      "post": {
        "description": "Encerra a sessão deste aparelho (a família do refresh) e apaga o cookie. Funciona mesmo com o access token vencido. Sempre responde 204.",
        "operationId": "logout_t__slug__auth_logout_post",
        "parameters": [
          {
            "description": "Identificador do salão na URL.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "Identificador do salão na URL.",
              "examples": [
                "studio-bella"
              ],
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "Enviado automaticamente pelo navegador (cookie httpOnly do login).",
            "in": "cookie",
            "name": "spbella_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Enviado automaticamente pelo navegador (cookie httpOnly do login).",
              "title": "Spbella Refresh"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sair",
        "tags": [
          "Login"
        ]
      }
    },
    "/t/{slug}/auth/me": {
      "get": {
        "description": "Dados da pessoa logada. Funciona também enquanto a senha provisória não foi trocada. Exige `Authorization: Bearer`.",
        "operationId": "me_t__slug__auth_me_get",
        "parameters": [
          {
            "description": "Identificador do salão na URL.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "Identificador do salão na URL.",
              "examples": [
                "studio-bella"
              ],
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
