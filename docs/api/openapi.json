{
  "components": {
    "schemas": {
      "ChangePasswordIn": {
        "properties": {
          "current_password": {
            "maxLength": 128,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordIn",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "ForgotPasswordIn": {
        "properties": {
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "turnstile_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnstile Token"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgotPasswordIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "description": "Sempre `ok` quando a API responde.",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Versão da API em execução.",
            "examples": [
              "0.1.0"
            ],
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "examples": [
              "dono@studio-bella.demo"
            ],
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "examples": [
              "demo-spbella"
            ],
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          },
          "turnstile_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Token do widget Cloudflare Turnstile.",
            "title": "Turnstile Token"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "const": "ok",
            "description": "Resultado da verificação do Postgres.",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ResetPasswordIn": {
        "properties": {
          "new_password": {
            "maxLength": 128,
            "title": "New Password",
            "type": "string"
          },
          "token": {
            "description": "Token que veio no link do e-mail.",
            "maxLength": 128,
            "title": "Token",
            "type": "string"
          },
          "turnstile_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnstile Token"
          }
        },
        "required": [
          "token",
          "new_password"
        ],
        "title": "ResetPasswordIn",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Segundos até o access token expirar.",
            "examples": [
              900
            ],
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "TenantPublicInfo": {
        "properties": {
          "country": {
            "enum": [
              "BR",
              "PY"
            ],
            "title": "Country",
            "type": "string"
          },
          "currency": {
            "description": "Moeda dos valores `*_minor`.",
            "enum": [
              "BRL",
              "PYG"
            ],
            "title": "Currency",
            "type": "string"
          },
          "locale": {
            "description": "Idioma padrão do salão.",
            "enum": [
              "pt-BR",
              "es"
            ],
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "examples": [
              "Studio Bella"
            ],
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "examples": [
              "studio-bella"
            ],
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "description": "Fuso horário IANA do salão.",
            "examples": [
              "America/Sao_Paulo"
            ],
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
