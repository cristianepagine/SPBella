# Copie para .env e preencha. O arquivo .env NUNCA vai para o repositório.

# --- Postgres (docker compose) ---
POSTGRES_DB=spbella
POSTGRES_USER=spbella
POSTGRES_PASSWORD=troque-esta-senha

# --- API ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Fora do Docker, aponte para localhost:
# DATABASE_URL=postgresql+psycopg://spbella:troque-esta-senha@localhost:5432/spbella
# Origens do front liberadas no CORS, separadas por vírgula. Em produção: https://app.<dominio>
CORS_ORIGINS=http://localhost:5173
# Swagger em /docs e ReDoc em /redoc. Deixe false em produção.
API_DOCS_ENABLED=true
