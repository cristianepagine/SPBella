# Copie para .env e preencha. O arquivo .env NUNCA vai para o repositório.

# --- Postgres (docker compose) ---
# Usuário administrador do Postgres: cria schemas, papéis e roda migrações (só a CLI usa).
POSTGRES_DB=spbella
POSTGRES_USER=spbella
POSTGRES_PASSWORD=troque-esta-senha
# Usuário da aplicação: a API conecta com ele. O "db init" cria/atualiza este papel.
APP_DB_USER=spbella_app
APP_DB_PASSWORD=troque-esta-outra-senha

# --- API ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Dentro do Docker, as duas conexões são montadas pelo docker-compose.yml.
# Fora do Docker (rodando a API ou a CLI direto na máquina), descomente:
# DATABASE_URL=postgresql+psycopg://spbella_app:troque-esta-outra-senha@localhost:5432/spbella
# DATABASE_ADMIN_URL=postgresql+psycopg://spbella:troque-esta-senha@localhost:5432/spbella
# Prefixo dos papéis de cada salão no Postgres (ex.: spbella_t_studio_ana).
TENANT_ROLE_PREFIX=spbella_
# Origens do front liberadas no CORS, separadas por vírgula. Em produção: https://app.<dominio>
CORS_ORIGINS=http://localhost:5173
# Swagger em /docs e ReDoc em /redoc. Deixe false em produção.
API_DOCS_ENABLED=true

# --- Salões em banco dedicado (opcional) ---
# Para um salão com dsn_ref=TENANT_DSN_STUDIO_ANA, defina as duas variáveis:
# TENANT_DSN_STUDIO_ANA=postgresql+psycopg://spbella_app:senha@outro-host:5432/studio_ana
# TENANT_DSN_STUDIO_ANA_ADMIN=postgresql+psycopg://admin:senha@outro-host:5432/studio_ana

# --- Testes do back-end com Postgres (precisa ser superusuário; os testes criam e apagam
# os bancos spbella_test*). Com o compose rodando:
# TEST_ADMIN_DATABASE_URL=postgresql+psycopg://spbella:troque-esta-senha@localhost:5432/postgres
